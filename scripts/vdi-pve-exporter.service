[Unit]
Description=Proxmox VE metrics exporter for vdi-tool
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/vdi-tool/.venv/bin/pve_exporter --config.file /etc/vdi-tool/pve-exporter.yml --web.listen-address 127.0.0.1:9221
Restart=on-failure

[Install]
WantedBy=multi-user.target
