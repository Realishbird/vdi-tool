{
 "uid": "vdi-storage",
 "title": "VDI storage and network links",
 "description": "Needs prometheus-node-exporter on the Proxmox host (port 9100).",
 "tags": [
  "vdi-tool"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "port",
    "label": "Network port",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "vdi-prom"
    },
    "query": {
     "query": "label_values(node_network_receive_bytes_total{job=\"host\"}, device)",
     "refId": "v"
    },
    "regex": "/^(?!lo$|veth|tap|fwbr|fwpr|fwln|vmbr|bonding_masters).*/",
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "disk",
    "label": "Disk",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "vdi-prom"
    },
    "query": {
     "query": "label_values(node_disk_read_bytes_total{job=\"host\"}, device)",
     "refId": "v"
    },
    "regex": "/^(nvme\\d+n\\d+|sd[a-z]+|dm-\\d+)$/",
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "editable": false,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Network in, selected ports",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "sum(rate(node_network_receive_bytes_total{job=\"host\",device=~\"$port\"}[1m])*8)",
     "legendFormat": ""
    }
   ]
  },
  {
