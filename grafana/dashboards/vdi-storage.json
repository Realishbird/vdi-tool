   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "(sum(rate(node_network_receive_bytes_total{job=\"host\",device=~\"$port\"}[1m])*8) + sum(rate(node_network_transmit_bytes_total{job=\"host\",device=~\"$port\"}[1m])*8)) / 400e9 * 100",
