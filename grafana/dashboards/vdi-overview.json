   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "sum(pve_cpu_usage_ratio{id=~\"qemu/.*\"} * pve_cpu_usage_limit{id=~\"qemu/.*\"})"
