  {
   "id": 22,
   "type": "stat",
   "title": "Benchmark run in progress",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 6,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "No"
        },
        "1": {
         "text": "Yes"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "max(vdi_run_active) or vector(0)"
    }
   ]
  },
  {
   "id": 23,
   "type": "table",
   "title": "Benchmark results (latest runs)",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 6,
    "y": 12,
    "w": 18,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Finished",
      "desc": true
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "format": "table",
     "instant": true,
     "expr": "vdi_run_result{measure=~\"total_iops|total_mbps|p95_ms|mean_ms|all_up_s|peak_host_cpu\"}"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "kind": true,
       "series": true
      },
      "renameByName": {
       "run": "Run",
       "workload": "Workload",
       "storage": "Storage",
       "clone": "Clones",
       "batch": "Batch",
       "measure": "Measure",
       "Value": "Value"
      }
     }
    }
   ]
  }
 ],
