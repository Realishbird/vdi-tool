   "title": "Host network ports: receive (needs the host metrics agent)",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
