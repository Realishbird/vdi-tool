{
 "uid": "vdi-overview",
 "title": "VDI overview",
 "tags": [
  "vdi-tool"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Desktops running",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "sum(pve_up{id=~\"qemu/.*\"})"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Host CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "avg(pve_cpu_usage_ratio{id=~\"node/.*\"}) * 100"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Host memory used",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "sum(pve_memory_usage_bytes{id=~\"node/.*\"}) / sum(pve_memory_size_bytes{id=~\"node/.*\"}) * 100"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Desktop vCPUs busy",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "sum(pve_cpu_usage_ratio{id=~\"qemu/.*\"} * pve_cpu_usage_limit{id=~\"qemu/.*\"})"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Host CPU by node",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "pve_cpu_usage_ratio{id=~\"node/.*\"} * 100",
     "legendFormat": "{{id}}"
    }
   ]
  },
