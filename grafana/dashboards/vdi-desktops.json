     },
     "expr": "rate(pve_network_transmit_bytes{id=~\"qemu/.*\"}[1m]) * on(id) group_left(name) pve_guest_info{name=~\"$desktop\"}",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Spread across selected desktops: disk write (slowest, median, fastest)",
   "datasource": {
    "type": "prometheus",
    "uid": "vdi-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "min(rate(pve_disk_write_bytes{id=~\"qemu/.*\"}[1m]) * on(id) group_left(name) pve_guest_info{name=~\"$desktop\"})",
     "legendFormat": "Slowest"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "quantile(0.5, rate(pve_disk_write_bytes{id=~\"qemu/.*\"}[1m]) * on(id) group_left(name) pve_guest_info{name=~\"$desktop\"})",
     "legendFormat": "Median"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "vdi-prom"
     },
     "expr": "max(rate(pve_disk_write_bytes{id=~\"qemu/.*\"}[1m]) * on(id) group_left(name) pve_guest_info{name=~\"$desktop\"})",
     "legendFormat": "Fastest"
    }
   ]
  }
 ]
}